# Planino waker configuration. Copy to poster.env next to wake.js.
# Every line here also reaches the runner script as an environment variable.

# The poster token from Planino (Settings, AI poster). Required.
PLANINO_POSTER_TOKEN=pln_poster_...

# Where Planino's poster API lives. The default is Planino's own project.
# PLANINO_POSTER_URL=https://suzqnyvfjbmnoipnlobk.supabase.co/functions/v1/browser-poster

# The Chrome Agent Bridge profile your AI posts through. Its /health is
# reported to Planino at every check-in.
BRIDGE_URL=http://127.0.0.1:3007
# BRIDGE_TOKEN=            # only if the bridge was started with one

# What to run when a job is queued. It gets the job id as its argument and
# JOB_ID, JOB_PLATFORM, PLANINO_POSTER_URL, PLANINO_POSTER_TOKEN and
# BRIDGE_URL in its environment.
#   runners/claude.sh   Claude Code, headless, with the hub's browser-post skill
#   runners/hermes.sh   a Hermes profile with the same skill
RUNNER=./runners/claude.sh

# Knobs for the runners.
# HUB_DIR=/root/hub              # claude.sh: the hub clone holding .claude/skills/browser-post
# CLAUDE_BIN=claude              # claude.sh: the executable
# HERMES_PROFILE=hub             # hermes.sh: which profile
# HERMES_BIN=hermes              # hermes.sh: the executable

# Timing. Peek every POLL_SEC seconds; check in every CHECKIN_SEC; kill a run
# that lasts longer than RUN_TIMEOUT_SEC.
POLL_SEC=120
CHECKIN_SEC=300
RUN_TIMEOUT_SEC=900

# The name reported to Planino for this poster's harness. Default: the runner's name.
# HARNESS=claude-code
