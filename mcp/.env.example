# Chrome Agent Bridge — MCP server (example environment)
# Copy to .env or set these in your MCP client's server config.

# URL of a RUNNING chrome-agent-bridge gateway (../gateway/index.js).
# Local (bridge on the same machine):   http://127.0.0.1:3007
# Remote (agent reaches the bridge over Tailscale): http://<bridge-tailnet-ip>:<port>
BRIDGE_URL=http://127.0.0.1:3007

# Optional: per-request timeout in ms (default 30000).
# BRIDGE_TIMEOUT_MS=30000

# Optional: cap on HTML returned by pc_browser_read, in chars (default 60000).
# BRIDGE_MAX_CONTENT_CHARS=60000
