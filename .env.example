# Chrome Agent Bridge - example environment
# Copy to .env and adjust as needed. Do NOT commit .env.

# Network interface the gateway binds to.
# 0.0.0.0 = reachable on all interfaces (intended for trusted private networks
# such as Tailscale). Use 127.0.0.1 for local-only testing.
HOST=0.0.0.0

# Port the gateway listens on.
PORT=3007

# Chrome DevTools Protocol endpoint. Must remain on 127.0.0.1.
# Never expose this to the network.
CDP_URL=http://127.0.0.1:9222
